# Copy this file to mac-mini.env and replace secret placeholders before running
# the single-stack Open WebUI deployment.

# Stable Docker Compose project name for the copied bundle.
HERMES_COMPOSE_PROJECT=hermes-mac-mini

# Stable Docker Compose project name for the generated multi-profile stack.
HERMES_PROFILES_COMPOSE_PROJECT=hermes-mac-mini-profiles

# Base host directory used for profile home/workspace defaults.
HERMES_PROFILES_BASE_DIR=/Users/Shared/hermes/profiles

# UID/GID default to `id -u` and `id -g`; uncomment only to override.
# HERMES_UID=501
# HERMES_GID=20

# Hermes API used by Open WebUI. Generate with: openssl rand -hex 32
HERMES_API_SERVER_KEY=replace-with-random-secret

# Hermes WebUI. Local-only uses 127.0.0.1. LAN access uses 0.0.0.0.
HERMES_WEBUI_BIND_IP=127.0.0.1
HERMES_WEBUI_PORT=8787

# Hermes Agent dashboard.
HERMES_DASHBOARD_BIND_IP=127.0.0.1
HERMES_DASHBOARD_HOST_PORT=9119

# Open WebUI at http://127.0.0.1:3000 by default.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main-slim
OPEN_WEBUI_BIND_IP=127.0.0.1
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_URL=http://127.0.0.1:3000
OPEN_WEBUI_NAME=RubikLab Chat
OPEN_WEBUI_DATA_DIR=/Users/Shared/hermes/open-webui
OPEN_WEBUI_SECRET_KEY=replace-with-random-secret

# Persistent host data. These paths are bind-mounted into the containers.
HERMES_HOME_DIR=/Users/Shared/hermes/home
HERMES_WORKSPACE_DIR=/Users/Shared/hermes/workspace

# Repository URL used by the generated multi-profile stack plugin installers.
HERMES_WIKI_REPO=https://github.com/zombiearnie88/hermes-wiki.git

# Shared memory for Hermes Agent and WebUI containers.
HERMES_SHM_SIZE=1g

# The production compose file defaults this to 1 to avoid broad chmods at startup.
HERMES_SKIP_CHMOD=1

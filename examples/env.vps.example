# Copy this file to .env.vps, update the placeholders, then deploy with:
# docker compose -f examples/docker-compose.production-vps.yml --env-file examples/.env.vps up -d

# Required: Let's Encrypt contact email for Traefik ACME certificates.
ACME_EMAIL=admin@rubiklab.vip

# Required: Hermes Agent API key for Open WebUI and https://openai.rubiklab.vip/v1.
# Generated with: openssl rand -hex 32
HERMES_API_SERVER_KEY=replace-with-random-secret

# Required: Hermes WebUI login password. Replace before deploying.
HERMES_WEBUI_PASSWORD=replace-with-random-password

# Required: Open WebUI at https://chat.rubiklab.vip.
OPEN_WEBUI_SECRET_KEY=replace-with-random-secret
OPEN_WEBUI_ADMIN_EMAIL=admin@rubiklab.vip
OPEN_WEBUI_ADMIN_PASSWORD=replace-with-random-password

# Required: BasicAuth for https://panel.rubiklab.vip.
# Username: admin
# Password: VX7ie2S0AkNB1NF/cR9O72If
# Password generated with: openssl rand -base64 18
# Hash generated with: openssl passwd -apr1 'VX7ie2S0AkNB1NF/cR9O72If'
# Dollar signs are doubled because Docker Compose interpolates env values.
HERMES_DASHBOARD_BASIC_AUTH=admin:$$apr1$$4jLM/vx0$$b4q14IjUlu4WBch8qkQz2/

# Persistent host data.
HERMES_HOME_DIR=/srv/hermes/home
HERMES_WORKSPACE_DIR=/srv/hermes/workspace
OPEN_WEBUI_DATA_DIR=/srv/hermes/open-webui

# Runtime user and resource settings.
HERMES_UID=1000
HERMES_GID=1000
HERMES_SHM_SIZE=1g
HERMES_SKIP_CHMOD=1

# Images. Pin these to immutable tags or digests for stricter production deploys.
TRAEFIK_IMAGE=traefik:v3.1
HERMES_AGENT_IMAGE=nousresearch/hermes-agent:latest
HERMES_WEBUI_IMAGE=ghcr.io/nesquena/hermes-webui:latest
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main-slim

# Named volumes.
HERMES_AGENT_SRC_VOLUME_NAME=hermes-agent-src
HERMES_WEBUI_VENV_VOLUME_NAME=hermes-webui-venv
TRAEFIK_LETSENCRYPT_VOLUME_NAME=traefik-letsencrypt
